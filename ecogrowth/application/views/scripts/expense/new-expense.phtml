    } else if (officeExpenseTo == "") {
      swal({
        title : "Transfer To Missing !",
        text  : "Please Select Expense Transfer To.",
        icon  : "error"
      }).then(function() {
        $("#officeExpenseTransferTo").focus();
      });
      return false;
    } else if (officeExpenseAmount == "") {
      swal({
        title : "Transfer Amount Missing !",
        text  : "Please Enter Transfer Amount.",
        icon  : "error"
      }).then(function() {
        $("#officeExpenseTransferAmount").focus();
      });
      return false;
    }
  }
</script>