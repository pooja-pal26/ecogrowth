<script>
  $(document).ready(function() {
    $(".select2").select2();
    $(".datepicker").datepicker({ dateFormat: "dd/mm/yy", changeYear:true, changeMonth:true });
  }); 
  function addMoreRowInOfficeExpenseForm() {
    var row_count = $('#expenseDetailsTable tr').length;
    var expenseType = $("#expenseTypeSelect").val();
    $.ajax({
      url: '/expense/get-expense-in-list/expense_type_id/1',
      type: 'GET',
      success:function(data){
        var data = JSON.parse(data);
        console.log(data);
        if (data.flag) {
          $("#expense_in_id_"+row_count).html(data.expenseOption);
        } else {
          swal({
            title : data.title,
            text  : data.message,
            icon  : "error"
          });
        }
      }
    });
    var html_content = `<tr id="row_`+row_count+`">
    <td>
    <select name="expense_in_id[]" id="expense_in_id_`+row_count+`" class="form-control select2" onchange="showExpenseForList(`+row_count+`)">
    <option value="">Please Select</option>
    </select>
    </td>
    <td>
    <select name="expense_for_id[]" id="expense_for_id_`+row_count+`"class="form-control select2">
    <option value="">Please Select</option>
    </select>
    </td>
    <td>
    <input type="text" class="form-control" name="spentAmount[]" id="spentAmount" required="">
    </td>
    <td><input type="text" class="form-control" name="spentRemark[]" id="spentRemark" required=""></td>
    <td><a href="javascript:void(0)" onclick="deleteRow(`+row_count+`)"><i class="fa fa-trash fa-2x" style="color:red;"></i></a></td>
    </tr>`;
    $("#expenseDetailsTable").append(html_content);
    $(".select2").select2();
  } 
  function deleteRow(count) {
   $("#row_"+count).remove();
 } 
 function showExpenseForList(row_number) {
  var expenseInId = $("#expense_in_id_"+row_number).val();
  if (expenseInId != "") {
    $.ajax({
      url: '/expense/get-expense-for-by-expense-in/expense_in_id/'+expenseInId,
      type: 'GET',
      success:function(data) {
       var data = JSON.parse(data);
       console.log(data);
       if (data.flag) {
        $("#expense_for_id_"+row_number).html(data.option);
      } else {
        swal({
          title : data.title,
          text  : data.message,
          icon  : "error"
        }).then(function(){
          $("#expense_for_id_"+row_number).html('<option value="">Please Select</option>');
        });
      } 
    }
  });
  } else {
    swal({
      title : "Expense In Missing!",
      text  : "Please try again after refreshing the page.",
      icon  : "error"
    });
  }
}
function getSitesByPoNumber() {
  var po_number = $("#poNumber").val();
  if (po_number != "") {
    $.ajax({
      url: '/siteallocation/get-sites-by-po-number',
      type: 'POST',
      data: {po_number: po_number},
      success:function(data){
        var data = JSON.parse(data);
        console.log(data);
        var option = "<option value=''>Select Site ID</option>";
        if (data.flag) {
          $.each(data.sites, function(index, site_id) {
            option += "<option value='"+site_id.site_id+"'>"+site_id.site_id+"</option>";
          });
        } else {
          option += "<option>"+data.message+"</option>";
        }
        $("#siteId").html(option);
      }
    });
  } else {
    $("#siteId").html("<option>Select Site ID</option>");
  }
}
function validateSiteExpenseInputData() {
  var siteExpenseDate     = $("#siteExpenseDateOfTransfer").val();
  var poNumber            = $("#poNumber").val();
  var siteId              = $("#siteId").val();
  var siteExpenseAmount   = $("#siteExpenseTransferAmount").val();
  var siteExpenseFor      = $("#siteExpenseTransferFor").val();
  var siteExpenseTo       = $("#siteExpenseTransferTo").val();
    // alert(siteExpenseAmount);
    // return false;
    if (siteExpenseDate == "") {
      swal({
        title : "Transfer Date Missing !",
        text  : "Please Select Date of Transfer.",
        icon  : "error"
      }).then(function() {
        $("#siteExpenseDateOfTransfer").focus();
      });
      return false;
    } else if (poNumber == "") {
      swal({
        title : "PO Number Missing !",
        text  : "Please Select PO Number.",
        icon  : "error"
      }).then(function() {
        $("#poNumber").focus();
      });
      return false;
    } else if (siteId == "") {
      swal({
        title : "Site Missing !",
        text  : "Please Select Site ID.",
        icon  : "error"
      }).then(function() {
        $("#siteId").focus();
      });
      return false;
    } else if (siteExpenseAmount == "") {
      swal({
        title : "Expense Amount Missing !",
        text  : "Please Enter Transfer Amount.",
        icon  : "error"
      }).then(function() {
        $("#siteExpenseTransferAmount").focus();
      });
      return false;
    } else if (siteExpenseFor == "") {
      swal({
        title : "Transfer For Missing !",
        text  : "Please Select Transfer For.",
        icon  : "error"
      }).then(function() {
        $("#siteExpenseTransferFor").focus();
      });
      return false;
    } else if (siteExpenseTo == "") {
      swal({
        title : "Transfer To Missing !",
        text  : "Please Select Transfer To.",
        icon  : "error"
      }).then(function() {
        $("#siteExpenseTransferTo").focus();
      });
      return false;
    }
  }
  function validateOfficeExpenseInputData() {
    var officeExpenseDate   = $("#officeExpenseDateOfTransfer").val();
    var officeExpenseFor    = $("#officeExpenseTransferFor").val();
    var officeExpenseTo     = $("#officeExpenseTransferTo").val();
