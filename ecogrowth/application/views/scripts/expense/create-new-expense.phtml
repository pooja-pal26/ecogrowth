			function showExpenseForList(row_number) {
				var expenseInId = $("#expense_in_id_"+row_number).val();
				if (expenseInId != "") {
					$.ajax({
						url: '/expense/get-expense-for-by-expense-in/expense_in_id/'+expenseInId,
						type: 'GET',
						success:function(data) {
							var data = JSON.parse(data);
							console.log(data);
							if (data.flag) {
								$("#expense_for_id_"+row_number).html(data.option);
								$("#is_required_"+row_number).val(data.is_required);
							} else {
								swal({
									title : data.title,
									text  : data.message,
									icon  : "error"
								}).then(function(){
									$("#expense_for_id_"+row_number).html('<option value="">Please Select</option>');
								});
							} 
						}
					}); 
				} else {
					swal({
						title : "Expense In Missing!",
						text  : "Please try again after refreshing the page.",
						icon  : "error"
					});
				}
			}
			function showDocumentList(row_number){
				var expense_remark = $('#expense_remark_'+row_number).val();
				if (expense_remark != "") {
