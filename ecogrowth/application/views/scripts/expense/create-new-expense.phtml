	<script>
		$(function() {
		    $("body").delegate(".datepicker", "focusin", function(){
		        $(this).datepicker({ dateFormat: "yy-mm-dd", changeYear:true, changeMonth:true, maxDate:0});		    
			});
		});


		$(document).ready(function() {
			$(".select2").select2();
			$("#expenseTypeSelect").change(function(event) {
				event.preventDefault();
				var expenseType = $("#expenseTypeSelect").val();
				var expenseTypeTextValue = $("#expenseTypeSelect option:selected").text();
				if (expenseType != "") {
					if (expenseTypeTextValue == "Site Expense") {
						$.ajax({
							url: '/expense/site-expense-form/expense_type/'+expenseType,
							type: 'GET',
							success:function (data) {
								$(".formDiv").html(data);
								$("#expenseType").val(expenseType);
							}
						});
						$(".formDiv").show();
					} else if (expenseTypeTextValue == "Office Expense") {
						$.ajax({
							url: '/expense/office-expense-form/expense_type/'+expenseType,
							type: 'GET',
							success:function (data) {
								$(".formDiv").html(data);
								$("#expenseType").val(expenseType);
							}
						});
						$(".formDiv").show();
					} 
				} else {
					$(".formDiv").hide();
				}
			});
		}); 
		function addMoreRow() {
			var siteId = $('#siteId').val();
			var row_count = $('#expenseDetailsTable tr').length;
			var expenseType = $("#expenseTypeSelect").val();
			var result1, result2;
			$.when(
				$.ajax({
					url: '/expense/get-expense-in-list/expense_type_id/'+expenseType,
					type: 'GET',
					success:function(data){
						var data = JSON.parse(data);
						console.log(data);
						if (data.flag) {
							result1 = data.expenseOption;
						} else {
							swal({
								title : data.title,
								text  : data.message,
								icon  : "error"
							});
						}
					}
				}),
				$.ajax({
					url: '/expense/get-site-document-for-list',
					type: 'GET',
					success:function(data){
						var data = JSON.parse(data);
						console.log(data);
						if (data.flag) {
							result_1 = data.option;
						} else {
							swal({
								title : data.title,
								text  : data.message,
								icon  : "error"
							});
						}
					}
				}),
				$.ajax({
					url: '/siteallocation/get-site-allocated-to-details',
					type: 'POST',
					data: {site_id: siteId},
					success:function(data){
						var data = JSON.parse(data);
						console.log(data);
						if (data.flag) {
							result2 = data.material_supplier_list;
						} else {
							swal({
								title : data.title,
								text  : data.message,
								icon  : "error"
							});
						}
					}
				})
				).then(function(){
					$("#expense_in_id_"+row_count).html(result1);
					$("#expense_remark_"+row_count).html(result_1);
					$("#amountTransferTo_"+row_count).html(result2);
				});
				var html_content = `<tr id="row_`+row_count+`">
				<td width="25%">
				<select name="expense_in_id[]" id="expense_in_id_`+row_count+`" class="form-control mandatorySelect select2" onchange="showExpenseForList(`+row_count+`)">
				<option value="">Please Select</option>
				</select>
				</td>
				<td>
				<select name="expense_for_id[]" id="expense_for_id_`+row_count+`"class="form-control mandatorySelect select2">
				<option value="">Please Select</option>
				</select>
				</td>
				<td>
				<input type="text" class="form-control mandatoryField"  name="spentAmount[]" id="spentAmount_`+row_count+`">
				</td>
				<td>
				<input type="text" class="form-control mandatoryField" name="spentRemark[]" id="spentRemark_`+row_count+`">
				</td>
				<td>
				<select id="expense_remark_`+row_count+`" name="expense_remark[]" class="form-control select2 mandatorySelect " required="required" onchange="checkRequired(this.value,`+row_count+`)"><option value="">Select</option>
				</select></td>
				<input type="hidden" id="is_required_`+row_count+`" class="is_require">

				<td> 
				<input type="file" class="form-control" name="bill_attachment[]" id="bill_attachment_`+row_count+`">
				</td>
				<td> 
				<input type="text" class="form-control datepicker mandatoryField" readonly="" name="date[]" id="date_`+row_count+`">
				</td>
				<td><a href="javascript:void(0)" onclick="deleteRow(`+row_count+`)"><i class="fa fa-trash fa-2x" style="color:red;"></i></a></td>
				</tr>`;
				$("#expenseDetailsTable").append(html_content);
				$(".select2").select2();
			} 
