			function validateSiteExpenseInputData() {
				var company_id     = $("#company_id option:selected").val();
				var siteExpenseDate     = $("#siteExpenseDateOfTransfer").val();
				var poNumber            = $("#poNumber").val();
				var siteId              = $("#siteId").val();
				var siteExpenseAmount   = $("#siteExpenseTransferAmount").val();
				var siteExpenseTo       = $("#siteExpenseTransferTo").val();
				// var billNumber          = $("#billAttachmentNumber").val();
				if (company_id == "") {
					swal({
						title : "Company Missing !",
						text  : "Please Select Company.",
						icon  : "error"
					}).then(function() {
						$("#siteExpenseDateOfTransfer").focus();
					});
					return false;
				}else if (siteExpenseDate == "") {
					swal({
						title : "Transfer Date Missing !",
						text  : "Please Select Date of Transfer.",
						icon  : "error"
					}).then(function() {
						$("#siteExpenseDateOfTransfer").focus();
					});
					return false;
				} else if (poNumber == "") {
					swal({
						title : "PO Number Missing !",
						text  : "Please Select PO Number.",
						icon  : "error"
					}).then(function() {
						$("#poNumber").focus();
					});
					return false;
				} else if (siteId == "") {
					swal({
						title : "Site Missing !",
						text  : "Please Select Site ID.",
						icon  : "error"
					}).then(function() {
						$("#siteId").focus();
					});
					return false;
				} else if (siteExpenseAmount == "") {
					swal({
						title : "Expense Amount Missing !",
						text  : "Please Enter Transfer Amount.",
						icon  : "error"
					}).then(function() {
						$("#siteExpenseTransferAmount").focus();
					});
					return false;
				} else {
					var error_count = validateRowData();
    		// alert(error_count);
    		if (error_count > 0) {
    			return false;
    		}
    	}
    }
    function validateRowData() {
    	var error_count = 0;
    	var require_error_count_1 = 0;
    	$('.mandatorySelect').each(function(e) {
    		if ($(this).val() == "") {
    			$(this).siblings(".select2-container").addClass('error_box');
    			error_count += 1;
    		} else {
    			$(this).siblings(".select2-container").removeClass('error_box');
    		}
    	});
    	$('.mandatoryField').each(function(e) {
    		if ($(this).val() == "") {
    			$(this).addClass('error_box');
    			error_count += 1;
    		} else {
    			$(this).removeClass('error_box');
    		}
    	});
    	require_error_count_1 =validateUploads();
    	//alert(require_error_count_1);
    	return error_count+require_error_count_1;
    }
