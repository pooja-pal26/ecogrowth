									text  : data.message,
									icon  : "error"
								}).then(function(){
									$("#expense_remark_"+row_number).html('<option value="">Please Select</option>');
								});
							} 
						}
					}); 
				} else {
					swal({
						title : "Site Document Type is  Missing!",
						text  : "Please try again after refreshing the page.",
						icon  : "error"
					});
				}
			}
