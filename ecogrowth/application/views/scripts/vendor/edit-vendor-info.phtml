<script>
  $(document).ready(function() {
    $(".select2").select2();
    $(".datepicker").datepicker({ dateFormat: "dd/mm/yy", changeYear:true, changeMonth:true });
    $(".uppercase").keyup(function(event) {
      event.preventDefault();
      $(this).val($(this).val().toUpperCase());
    });
  }); 
  function showImage(inputFile, value) {
    if (value == "expCertificateImage") {
      if (inputFile.files && inputFile.files[0]) {
        var readFile = new FileReader();
        readFile.onload = function(e){
          $("#expCertificateImage")
          .attr('src', e.target.result)
          .width(150)
          .height(100);
        };
        readFile.readAsDataURL(inputFile.files[0]);
      }
    } else if (value == "panCardImage") {
      if (inputFile.files && inputFile.files[0]) {
        var readFile = new FileReader();
        readFile.onload = function(e){
          $("#panCardImage")
          .attr('src', e.target.result)
          .width(150)
          .height(100);
        };
        readFile.readAsDataURL(inputFile.files[0]);
      }
    } else if (value == "gstCertificateImage") {
      if (inputFile.files && inputFile.files[0]) {
        var readFile = new FileReader();
        readFile.onload = function(e){
          $("#gstCertificateImage")
          .attr('src', e.target.result)
          .width(150)
          .height(100);
        };
        readFile.readAsDataURL(inputFile.files[0]);
      }
    } else if (value == "registrationImage") {
      if (inputFile.files && inputFile.files[0]) {
        var readFile = new FileReader();
        readFile.onload = function(e){
          $("#registrationImage")
          .attr('src', e.target.result)
          .width(150)
          .height(100);
        };
        readFile.readAsDataURL(inputFile.files[0]);
      }
    }
  }
  $(".next-step").click(function (e) {

    var $active = $('.wizard .nav-tabs li.active');
    $active.next().removeClass('disabled');
    nextTab($active);

  });
  $(".prev-step").click(function (e) {

    var $active = $('.wizard .nav-tabs li.active');
    prevTab($active);

  });
  function nextTab(elem) {
    $(elem).next().find('a[data-toggle="tab"]').click();
  }
  function prevTab(elem) {
    $(elem).prev().find('a[data-toggle="tab"]').click();
  }
