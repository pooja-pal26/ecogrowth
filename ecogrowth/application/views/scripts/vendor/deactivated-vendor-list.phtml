      <?php foreach ($this->messages as $message): ?>
        <?php if ($message['success']){ ?>
          <div class="alert alert-success">
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
            <strong>Success !</strong>&nbsp; <?php echo $message["success"]; ?>
          </div>
        <?php } else if ($message['error']) { ?>
          <div class="alert alert-danger">
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
            <strong>Error !</strong>&nbsp; <?php echo $message["error"]; ?>
          </div>
        <?php } ?>
      <?php endforeach ?>
    <?php endif ?>
    <div class="panel panel-primary">
      <div class="panel panel-heading">
        <h3>Deactivated Vendor List
          <div class="pull-right">
            <a href="/vendor" class="btn btn-success">View All Vendors</a>
          </div></h3>
        </div>
        <div class="panel panel-body">
          <div class="table-responsive" id="user-list">
            <table class="display" width="100%" id="vendorDtailsTable">
              <thead>
                <th>#</th>
                <th>Vendor Name</th>
                <th>Proprietor/Director Name</th>
                <th>Contact Person</th>
                <th>Contact Number</th>
                <th>Action</th>
              </thead>
              <tbody>
                <?php if($this->deactivatedVendorDetails){ 
                  $i = 1; 
                  foreach($this->deactivatedVendorDetails as $deactiveVendor){ ?>
                    <tr>
                      <td><?php echo $i; ?></td>
                      <td><?php echo $deactiveVendor['vendor_name']; ?></td>
                      <td><?php echo $deactiveVendor['prop_director_name'];?></td>
                      <td><?php echo $deactiveVendor['contact_person']; ?></td>
                      <td><?php echo $deactiveVendor['contact_number']; ?></td>
                      <td>
                        <a href="javascript:;" title="Activate Profile" onclick="activateVendorProfile(<?php echo $deactiveVendor['id']; ?>)" style="color: #1DAA29;"><i class="fa fa-sign-in"></i></a>
                        &nbsp;&nbsp;
                        <a href="javascript:;" title="Delete Profile" onclick="deleteVendorProfile(<?php echo $deactiveVendor['id']; ?>)" style="color: red;"><i class="fa fa-trash"></i></a>
                      </td>
                    </tr>
                    <?php $i++; }}?>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <script>
        $(document).ready(function() {
          $("#vendorDtailsTable").DataTable();
        });
        function activateVendorProfile(vendorId) {
          if (vendorId == "") {
            swal({
              title : "Something Went Wrong!",
              text  : "Please try after refreshing the page.",
              icon  : "error"
            });
          } else {
            swal({
              title : "Are you sure!",
              text  : "Do you want to activate clicked vendor profile?",
              icon  : "warning",
              buttons: [true, "Yes, activate"],
              dangerMode : true
            }).then(function(isConfirm){
              if (!isConfirm) {
                return false;
              } else {
                $.ajax({
                  url: '/vendor/activate-vendor-profile',
                  type: 'POST',
                  data: {vendor_id: vendorId},
                  success:function(data){
                    var data = JSON.parse(data);
                    if (data.flag) {
                      swal({
                        title : "Activated",
                        text  : data.message,
                        icon  : "success"
                      }).then(function(){
                        location.reload("/vendor");
                      });
                    } else {
                      swal({
                        title : "Something Went Wrong!",
                        text  : data.message,
                        icon  : "error"
                      });
                    }
                  }
                });
              }
            });
          }
        }
        function deleteVendorProfile(vendorId) {
          if (vendorId == "") {
            swal({
              title : "Something Went Wrong!",
              text  : "Please try after refreshing the page.",
              icon  : "error"
            });
          } else {
            swal({
              title : "Are you sure!",
              text  : "Do you want to delete clicked vendor profile?",
              icon  : "warning",
              buttons: [true, "Yes, delete"],
              dangerMode : true
            }).then(function(isConfirm){
              if (!isConfirm) {
                return false;
              } else {
                $.ajax({
                  url: '/vendor/delete-vendor-profile',
                  type: 'POST',
                  data: {vendor_id: vendorId},
                  success:function(data){
                    var data = JSON.parse(data);
                    if (data.flag) {
                      swal({
                        title : "Deleted",
                        text  : data.message,
                        icon  : "success"
                      }).then(function(){
                        location.reload("/vendor");
                      });
                    } else {
                      swal({
                        title : "Something Went Wrong!",
                        text  : data.message,
                        icon  : "error"
                      });
                    }
                  }
                });
              }
            });
          }
        }
      </script>