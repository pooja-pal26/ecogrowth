    function validateUploads(){
      var error_count = 0;
      $('.is_require').each(function(e) {
        if ($(this).val() == 1) {
          var element_id = $(this).attr('id');
          tempArr = element_id.split('_');
          count = tempArr[2];
          if($('#bill_attachment_'+count).val() == ""){
            swal({
              title : "Attachment Required !",
              text  : "Please Select File Attachment.",
              icon  : "error"
            }).then(function() {
              $("bill_attachment_"+count).focus();
            });
            $('#bill_attachment_'+count).css('background-color','red');
            error_count += 1;
          }
        } 
      });
      return error_count;
    }
    function checkRequired(value,row){
      var tempArr = value.split('-');
      $('#is_required_'+row).val(tempArr[1]);
    }
