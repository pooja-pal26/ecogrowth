<script>
  $(document).ready(function() {
    $(".select2").select2();
    $("#incidentTypeSelect").change(function(event) {
      event.preventDefault();
      var incidentType = $("#incidentTypeSelect").val();
      var incidentTypeTextValue = $("#incidentTypeSelect option:selected").text();
      if (incidentType != "") {
        if (incidentTypeTextValue == "Site Incident") {
          $.ajax({
            url: '/manage-po-site/site-incident-form/incident_type/'+incidentType,
            type: 'GET',
            success:function (data) {
              $(".formDiv").html(data);
              $("#incidentType").val(incidentType);
            }
          });
          $(".formDiv").show();
        } else if (incidentTypeTextValue == "Office Incident") {
          $.ajax({
            url: '/manage-po-site/office-incident-form/incident_type/'+incidentType,
            type: 'GET',
            success:function (data) {
              $(".formDiv").html(data);
              $("#incidentType").val(incidentType);
            }
          });
          $(".formDiv").show();
        } 
      } else {
        $(".formDiv").hide();
      }
    });
  }); 
  function addMoreRow() {
