    function showincidentForList(row_number) {
      var incidentInId = $("#incident_in_id_"+row_number).val();
      if (incidentInId != "") {
        $.ajax({
          url: '/incident/get-incident-for-by-incident-in/incident_in_id/'+incidentInId,
          type: 'GET',
          success:function(data) {
            var data = JSON.parse(data);
            console.log(data);
            if (data.flag) {
              $("#incident_for_id_"+row_number).html(data.option);
              $("#is_required_"+row_number).val(data.is_required);
            } else {
              swal({
                title : data.title,
                text  : data.message,
                icon  : "error"
              }).then(function(){
                $("#incident_for_id_"+row_number).html('<option value="">Please Select</option>');
              });
            } 
          }
        }); 
      } else {
        swal({
          title : "incident In Missing!",
          text  : "Please try again after refreshing the page.",
          icon  : "error"
        });
      }
    }
