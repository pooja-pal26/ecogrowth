      </select>
      </td>
      <td>
      <select name="incident_for_id[]" id="incident_for_id_`+row_count+`"class="form-control mandatorySelect select2">
      <option value="">Please Select</option>
      </select>
      </td>
      <td>
      <input type="text" class="form-control mandatoryField"  name="spentAmount[]" id="spentAmount_`+row_count+`">
      </td>
      <td>
      <input type="text" class="form-control mandatoryField" name="spentRemark[]" id="spentRemark_`+row_count+`">
