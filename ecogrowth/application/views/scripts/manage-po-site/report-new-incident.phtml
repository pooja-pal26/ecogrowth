      </td>
      <td><a href="javascript:void(0)" onclick="deleteRow(`+row_count+`)"><i class="fa fa-trash fa-2x" style="color:red;"></i></a></td>
      </tr>`;
      $("#incidentDetailsTable").append(html_content);
      $(".select2").select2();
    } 
