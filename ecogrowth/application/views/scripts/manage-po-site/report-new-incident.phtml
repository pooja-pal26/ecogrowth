      $.ajax({
        url: '/incident/get-incident-in-list/incident_type_id/'+incidentType,
        type: 'GET',
        success:function(data){
          var data = JSON.parse(data);
          console.log(data);
          if (data.flag) {
            result1 = data.incidentOption;
          } else {
            swal({
              title : data.title,
              text  : data.message,
