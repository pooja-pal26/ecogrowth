    function getSitesByPoNumber() {
        var po_number = $("#po_number").val();
        if (po_number != "") {
            $.ajax({
                url: '/siteallocation/get-sites-by-po-number',
                type: 'POST',
                data: {po_number: po_number},
                success:function(data){
                    var data = JSON.parse(data);
                    console.log(data);
                    var option = "<option value=''>Select Site</option>";
                    if (data.flag) {
                        $.each(data.sites, function(index, site_id) {
                            option += "<option value='"+site_id.site_id+"'>"+site_id.site_id+"</option>";
                        });
                    } else {
                        option += "<option>"+data.message+"</option>";
                    }
                    $("#site_id").html(option);
                }
            });
        } else {
            // $("#site_id").empty();
            $("#site_id").html("<option>Select Site</option>");
        }
    }

