            function getSiteNameFromPoNo(count) {
                var po_no = $("#po_no_"+count+" option:selected").text();
                if (po_no) {
                    $.ajax({
                        url: '/material-stock/get-site-name-from-po-no/po_no/'+po_no,
                        type: 'GET',
                        success:function (data) {
                            var data = JSON.parse(data);
                            $("#site_id_"+count).empty();
                            $("#site_id_"+count).append(data.data);
                        }
                    });

                }
            }

            function showProductList(count) {
                var productTypeId = $("#product_category_"+count).val();
                if (productTypeId) {
                    $.ajax({
                        url: '/material-stock/get-products-by-product-category/product_type_id/'+productTypeId,
                        type: 'POST',
                        success:function (data) {
                            var data = JSON.parse(data);
                            $("#product_id_"+count).empty();
                            $("#product_id_"+count).append(data);
                        }
                    });

                }
            } 

            function getTotalQuantityFromProduct(count) {
                var productId = $("#product_id_"+count).val();
                if (productId != '') {
                    $.ajax({
                        url: '/material-stock/get-total-quantity-from-poduct/product_id/'+productId,
                        type: 'POST',
                        success:function(data){
                            var data = JSON.parse(data);
                            $("#total_quantity_"+count).val(data.unit);
                        }
                    });
                } else {
                    $("#total_quantity_"+count).val('');
                }         
            } 

            function setUnitOfProduct(count) {
                var productTypeId = $("#product_category_"+count).val();
                var productId = $("#product_id_"+count).val();
                if (productId != '') {
                    $.ajax({
                        url: '/material-stock/get-product-unit-and-quantity-by-product-id',
                        type: 'POST',
                        data:{productTypeId:productTypeId, productId:productId},
                        success:function(data){
                            console.log(data);
                            var data = JSON.parse(data);
                            $("#unit_"+count).val(data.unit);
                            $("#total_quantity_"+count).val(data.total_quantity);
                        }
                    });
                } else {
                    $("#unit_"+count).val('');
                }         
            }     
            function deleteRow(count) {
                $("#row_"+count).remove();
            } 

