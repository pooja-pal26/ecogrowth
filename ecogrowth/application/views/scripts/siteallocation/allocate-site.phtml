<script>
	$(document).ready(function() {
		$(".select2").select2();
		$(".datepicker").datepicker({ dateFormat: "dd/mm/yy", changeYear:true, changeMonth:true});
	}); 
	function getSitesByPoNumberForAllocation() {
		var po_number = $("#poNumber").val();
		if (po_number != "") {
			$("#loading-bg").show();
			$.ajax({
				url: '/siteallocation/get-sites-by-po-number-for-allocation',
				type: 'POST',
				data: {po_number: po_number},
				success:function(data){
					var data = JSON.parse(data);
					console.log(data);
					$("#loading-bg").hide();
					var option = "<option value=''>Select Site ID</option>";
					if (data.flag) {
						$.each(data.sites, function(index, site_id) {
							option += "<option value='"+site_id.site_id+"'>"+site_id.site_id+"</option>";
						});
					} else {
						option += "<option>"+data.message+"</option>";
					}
					$("#siteId").html(option);
					$("#po_date").val(data.po_date);
				}
			});
		} else {
			swal({
				title : "PO Number Missing!",
				text  : "Please select PO number first.",
				icon  : "error"
			}).then(function(){
				$("#siteId").html("<option>Select Site ID</option>");
				$("#po_date").val('');
				$("#infratel_id").val('');
				$("#zone").val('');
				$("#location").val('');
				$("#cluster").val('');
				$("#cluster_incharge").val('');
				$("#cluster_mobile").val('');
				$("#technician_name").val('');
				$("#technician_mobile").val('');
				$("#site_latitude").val('');
				$("#site_longitude").val('');
				$("#work_type").val('');
			});
		}
	}
	function getSiteTechnicalDetails() {
		var site_id = $("#siteId").val();
		if (site_id != "") {
			$("#loading-bg").show();
			$.ajax({
				url: '/siteallocation/get-site-matrix-details',
				type: 'POST',
				data: {site_id: site_id},
				success:function (data) {
					var data = JSON.parse(data);
					console.log(data);
					$("#loading-bg").hide();
					if (data.flag) {
						var site_data = data.site_data;
						$("#infratel_id").val(site_data.infratel_id);
						$("#zone").val(site_data.zone);
						$("#location").val(site_data.location);
						$("#cluster").val(site_data.cluster);
						$("#cluster_incharge").val(site_data.cluster_incharge);
						$("#cluster_mobile").val(site_data.cluster_mobile);
						$("#technician_name").val(site_data.tech_name);
						$("#technician_mobile").val(site_data.tech_mobile);
						$("#site_latitude").val(site_data.latitude);
						$("#site_longitude").val(site_data.longitude);
						$("#work_type").val(site_data.work_type);
					} else {

					}
				}
			});
		} else {
			$("#infratel_id").val('');
			$("#zone").val('');
			$("#location").val('');
			$("#cluster").val('');
			$("#cluster_incharge").val('');
			$("#cluster_mobile").val('');
			$("#technician_name").val('');
			$("#technician_mobile").val('');
			$("#site_latitude").val('');
			$("#site_longitude").val('');
			$("#work_type").val('');
		}
	}
	function showDetailsToAllocateSite(row) {
		var resourceType = $("#resource_type_"+row).val();
		if (resourceType == "Staff" || resourceType == "Direct") {
			$.ajax({
				url: '/user/get-supervisor-list',
				type: 'GET',
				success:function (data) {
					var data = JSON.parse(data);
					console.log(data);
					if (data.flag) {
						$("#supervisor_id_"+row).html(data.supervisor_list);
						$("#vendorNameTd_"+row).html('<input type="text" class="form-control" name="vendor_id[]" id="blankTd_'+row+'" />');
						$("#blankTd_"+row).attr('readonly', true);
						$("#blankTd_"+row).val('');
					} else {
						swal({
							title : data.title,
							text  : data.message,
							icon  : "error"
						});
					}
				}

			});
		} else if (resourceType == "Vendor") {
			$.ajax({
				url: '/vendor/get-vendor-list',
				type: 'GET',
				success:function (data) {
					var data = JSON.parse(data);
					console.log(data);
					if (data.flag) {
						$("#vendorNameTd_"+row).html('<select name="vendor_id[]" id="vendor_id_'+row+'" class="form-control select2" onchange="getVendorSupervisorList('+row+')">');
						$("#vendor_id_"+row).html(data.vendor_list);
						$(".select2").select2();
					} else {
						swal({
							title : data.title,
							text  : data.message,
							icon  : "error"
						});
					}
				}
			});
			
		} else {
			$("#supervisor_id_"+row).html('<option value="">Please Select</option>');
		}
	}
	function getVendorSupervisorList(row) {
		var vendor_id = $("#vendor_id_"+row).val();
		if (vendor_id != "") {
			$.ajax({
				url: '/vendor/get-vendor-supervisor-list-by-vendor-id',
				type: 'POST',
				data: {vendor_id: vendor_id},
				success:function(data){
					var data = JSON.parse(data);
					console.log(data);
					if (data.flag) {
						$("#supervisor_id_"+row).html(data.supervisor_list);
					} else {
						swal({
							title : data.title,
							text  : data.message,
							icon  : "error"
						});
					}
				}
			});
		} else {
			swal({
				title : "Vendor Name Missing!",
				text  : "Please select vendor name from vendor list.",
				icon  : "error"
			}).then(function(){
				$("#supervisor_id_"+row).html('<option value="">Please Select</option>');
			});
		}
	}
	function addMoreRow() {
		var row_count = $('#workAllocationTable tr').length;
		var html_content = `<tr id="row_`+row_count+`">
		<td>
		<select name="nature_of_work[]" id="nature_of_work_`+row_count+`" class="form-control mandatory select2">
