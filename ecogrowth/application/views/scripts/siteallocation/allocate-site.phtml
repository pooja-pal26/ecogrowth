		</td>
		<td id="vendorNameTd_`+row_count+`">
		<select name="vendor_id[]" id="vendor_id_`+row_count+`" class="form-control select2" onchange="getVendorSupervisorList(`+row_count+`)">
		<option value="">Please Select</option>
		</select>
		</td>
		<td>
		<select name="supervisor_id[]" id="supervisor_id_`+row_count+`" class="form-control mandatory select2">
		<option value="">Please Select</option>
		</select>
		<span id="" class="error" style=" display: none; color: red; font-weight: bold;"><i class="fa fa-exclamation-circle error" style="color: red;"></i>&nbsp;Please Select</span>
		</td>
		<td>
		<input type="text" class="form-control datepicker" name="completion_date[]" id="completion_date_`+row_count+`" readonly="" value="<?php echo date('d/m/Y'); ?>">
		</td>
		<td><a href="javascript:void(0)" onclick="deleteRow(`+row_count+`)"><i class="fa fa-trash fa-2x" style="color:red;"></i></a></td>
		</tr>`;
		$("#workAllocationTable").append(html_content);
		$(".select2").select2();
		$(".datepicker").datepicker({ dateFormat: "dd/mm/yy", changeYear:true, changeMonth:true }); 
	} 
	function deleteRow(count) {
		$("#row_"+count).remove();
	} 
	function getClientMasterList() {
		var state_id = $("#state_id").val();
		if (state_id == "") {
			swal({
				title : "State Missing!",
				text  : "Please select state name.",
				icon  : "error"
			}).then(function(){
				$("#state_id").select2('open');
			});
			$("#client_id").empty();
			$("#client_id").append('<option value="">Select Client</option>');
			return false;
		} else {
			$("#loading-bg").show();
			$.ajax({
				url: '/master/get-client-details',
				type: 'POST',
				data: {state_id: state_id},
				success:function(data){
					var data = JSON.parse(data);
					$("#loading-bg").hide();
					console.log(data);
					if (data.flag) {
						$("#client_id").empty();  
						$("#client_id").append('<option value="">Select Client</option>');  
						$.each(data.clientDetails, function(index, val) {
							$("#client_id").append('<option value="'+val.id+'">'+val.client_name+'</option>');  
						});
					} else {
						swal({
							title : data.title,
							text  : data.message,
							icon  : "error"
						});
						$("#client_id").empty();  
						$("#client_id").append('<option value="">Select Client</option>');  
					}
				}
			});
		}
	}
	function getPoList() {
		var state_id = $("#state_id").val();
		var client_id = $("#client_id").val();
		if (state_id == "") {
			swal({
				title : "State Missing!",
				text  : "Please select state name.",
				icon  : "error"
			}).then(function(){
				$("#state_id").select2('open');
			});
			return false;
		} else if (client_id == "") {
			swal({
				title : "Client Missing!",
				text  : "Please select client name.",
				icon  : "error"
			}).then(function(){
				$("#client_id").select2('open');
			});
			return false;
		} else {
			$("#loading-bg").show();
			$.ajax({
				url: '/manage-po-site/get-po-list-by-state-and-client',
				type: 'POST',
				data: {state_id: state_id, client_id: client_id},
				success:function(data){
					var data = JSON.parse(data);
					console.log(data);
					$("#loading-bg").hide();
					if (data.flag) {
						$("#poNumber").empty();
						$("#poNumber").append("<option value=''>Select PO Number</option>");
						$("#poNumber").append(data.poList);
					} else {
						swal({
							title : data.title,
							text  : data.message,
							icon  : "error"
						});
						return false;
					}
				}
			});
		}
	}
	function validateInputData() {
		var poNumber     = $("#poNumber").val();
		var siteId       = $("#siteId").val();
		var siteCompletion = $("#site_completion_date").val();
		if (poNumber == "") {
			swal({
				title : "PO Number Missing!",
				text  : "Please select PO Number.",
				icon  : "error"
			}).then(function(){
				$("#poNumber").focus();
			});
			return false;
		} else if (siteId == "") {
			swal({
				title : "Site ID Missing!",
				text  : "Please select site ID.",
				icon  : "error"
			}).then(function(){
				$("#siteId").focus();
			});
			return false;
		} else if (siteCompletion == "") {
			swal({
				title : "Completion Date Missing!",
				text  : "Please select site completion date.",
				icon  : "error"
			}).then(function(){
				$("#site_completion_date").focus();
			});
			return false;
		} else {
			$('.mandatory').each(function(e) {
				if ($(this).val() == "") {
					$(this).siblings(".select2-container").addClass('error_box');
				} else {
					$(this).siblings(".select2-container").removeClass('error_box');
				}
				return false;
			});
		}
	}
</script>