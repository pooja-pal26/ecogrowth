 function validateUser(){
  var firstName     = $("#first_name").val();
  var mobileNumber  = $("#mobile_number").val();
  var alternateNum  = $("#alternate_mobile").val();
  var emailId       = $("#email_id").val();
  var department    = $("#department").val();
  var roleType      = $("#role_type").val();
  var role          = $("#role").val();
  var dateOfJoining = $("#doj").val();
  var password      = $("#password").val();
  var confirmPass   = $("#confirmPassword").val();
  if (firstName == "") {
    swal({
      title:"First Name Missing !",
      text:"Please Enter First Name",
      icon:"error"
    }).then(function(){
      $("#first_name").focus();
    });
    return false;
  } else if (mobileNumber == "") {
    swal({
      title:"Mobile Number Missing !",
      text:"Please Enter Mobile Number",
      icon:"error"
    }).then(function(){
      $("#mobile_number").focus();
    });
    return false;
  } else if (isNaN(mobileNumber)) {
    swal({
      title:"Invalid Number !",
      text:"Please Enter Numbers Only",
      icon:"error"
    }).then(function(){
      $("#mobile_number").val("");
      $("#mobile_number").focus();
    });
    return false;
  } else if (alternateNum && isNaN(alternateNum)) {
    swal({
      title:"Invalid Alternate Number !",
      text:"Please Enter Numbers Only",
      icon:"error"
    }).then(function(){
      $("#alternate_mobile").focus();
    });
    return false;
  } else if (alternateNum && alternateNum.length > 10 || alternateNum && alternateNum.length < 10 ) {
    swal({
      title:"Invalid Alternate Number !",
      text:"Please Enter 10 Digit Mobile Number",
      icon:"error"
    }).then(function(){
      $("#alternate_mobile").focus();
    });
    return false;
  } else if (mobileNumber.length > 10 || mobileNumber.length < 10) {
    swal({
      title:"Invalid Number !",
      text:"Please Enter 10 Digit Mobile Number",
      icon:"error"
    }).then(function(){
      $("#mobile_number").focus();
    });
    return false;
  } else if (emailId == "") {
    swal({
      title:"Email ID Missing !",
      text:"Please Enter Email ID",
      icon:"error"
    }).then(function(){
      $("#email_id").focus();
    });
    return false;
  } else if (department == "") {
    swal({
      title:"Department Missing !",
      text:"Please Select Department",
      icon:"error"
    }).then(function(){
      $("#department").focus();
    });
    return false;
  } else if (roleType == "") {
    swal({
      title:"Role Type Missing !",
      text:"Please Select Role Type",
      icon:"error"
    }).then(function(){
      $("#role_type").focus();
    });
    return false;
  } else if (role == "") {
    swal({
      title:"Role Missing !",
      text:"Please Select Role",
      icon:"error"
    }).then(function(){
      $("#role").focus();
    });
    return false;
  } else if (dateOfJoining == "") {
    swal({
      title:"Joining Date Missing !",
      text:"Please Select Date of Joining",
      icon:"error"
    }).then(function(){
      $("#doj").focus();
    });
    return false;
  } else if (password == "") {
    swal({
      title:"Password Missing !",
      text:"Please Enter Password",
      icon:"error"
    }).then(function(){
      $("#password").focus();
    });
    return false;
  } else if (confirmPass == "") {
    swal({
      title:"Confirm Password Missing !",
      text:"Please Enter Confirm Password",
      icon:"error"
    }).then(function(){
      $("#confirmPassword").focus();
    });
    return false;
  } else if (confirmPass != password) {
    swal({
      title:"Confirm Password Mismatch !",
      text:"Confirm Password should be same as Password",
      icon:"error"
    }).then(function(){
      $("#confirmPassword").val("");
      $("#confirmPassword").focus();
    });
    return false;
  }
}

function showImage(inputFile) {
  if (inputFile.files && inputFile.files[0]) {
    var readFile = new FileReader();
    readFile.onload = function(e){
      $("#selectedFile")
      .attr('src', e.target.result)
      .width(80)
      .height(60);
    };
    readFile.readAsDataURL(inputFile.files[0]);
    $("#removeImage").show();
  }
}
</script>