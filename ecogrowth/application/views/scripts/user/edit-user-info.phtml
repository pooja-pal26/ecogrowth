<script type="text/javascript">
 function Capture(id) {
  try {
    document.getElementById('data_finger_'+id).src = "data:image/bmp;base64,";
    document.getElementById('finger_iso_'+id).value = "";
    document.getElementById('img_finger_'+id).value = "";

    var res = CaptureFinger();
    if (res.httpStaus) {

      if (res.data.ErrorCode == "0") {
        document.getElementById('data_finger_'+id).src = "data:image/bmp;base64," + res.data.BitmapData;
        document.getElementById('finger_iso_'+id).value = res.data.IsoTemplate;
        document.getElementById('img_finger_'+id).value = res.data.BitmapData;
      }
    }
    else {
      alert(res.err);
    }
  }
  catch (e) {
    alert(e);
  }
  return false;
} 

</script>

