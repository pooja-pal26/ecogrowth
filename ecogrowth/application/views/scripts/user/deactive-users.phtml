												&nbsp;&nbsp;
												<a href="javascript:void(0)" class="tododelete redcolor" onclick="permanentDeleteUser('<?php echo md5($deactiveUser['id']);?>', '<?php echo ucwords(strtolower($deactiveUser['name'])); ?>')" title="Permanent Delete"><i class="fa fa-trash" style="color: red;"></i></a></td>
