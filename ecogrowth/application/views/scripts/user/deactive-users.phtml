				<script>
					$(document).ready(function() {
						$("#deactiveUserListTable").DataTable();
					});

					function activateUserProfile(userId, name) {
						if (userId == "") {
							swal("User Missing !","User ID is missing. Please try again.","error");
							return false;
						}
						swal({
							title:"Are You Sure !",
							text:"Do you want to activate "+name,
							icon:"warning",
							buttons:[true, "Yes, Activate"],
							dangerMode:true
						}).then(function(isConfirm){
							if (!isConfirm) {
								return false;
							} else {
								$.ajax({
									url: '/user/activate-user-profile/user_id/'+userId+'/name/'+name,
									type: 'GET',
									success:function (data) {
										var data = JSON.parse(data);
										if (data.flag == true) {
											swal({
												title:"Activated Successfully",
												text:data.message,
												icon:"success"
											}).then(function(){
												window.location.reload();
											});
										} else {
											swal("Something Went Wrong",data.message,"error");
										}
									}
								});
							}
						});
					}

					function permanentDeleteUser(userId, name) {
						if (userId == "") {
							swal("User Missing !","User ID is missing. Please try again.","error");
							return false;
						}
						swal({
							title:"Are You Sure !",
							text:"Do you want to delete "+name+" permanently.",
							icon:"warning",
							buttons:[true, "Yes, Delete"],
							dangerMode:true
						}).then(function(isConfirm){
							if (!isConfirm) {
								return false;
							} else {
								$.ajax({
									url: '/user/delete-user-profile/user_id/'+userId+'/name/'+name,
									type: 'GET',
									success:function (data) {
										var data = JSON.parse(data);
										if (data.flag == true) {
											swal({
												title:"Deleted Successfully",
												text:data.message,
												icon:"success"
											}).then(function(){
												window.location.reload();
											});
										} else {
											swal("Something Went Wrong",data.message,"error");
										}
									}
								});
							}
						});
					}
				</script>