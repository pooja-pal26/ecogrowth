        <script>
            function checkValidData() {
                var email = $("#email").val();
                var password = $("#password").val();
                if (email == "") {
                    swal({
                        title:"Email Missing !",
                        text:"Please enter email.",
                        icon:"error"
                    }).then(function(){
                        $("#email").focus();
                    });
                    return false;
                } else if (password == "") {
                    swal({
                        title:"Password Missing !",
                        text:"Please enter password.",
                        icon:"error"
                    }).then(function(){
                        $("#password").focus();
                    });
                    return false;
                }
            }
        </script>
