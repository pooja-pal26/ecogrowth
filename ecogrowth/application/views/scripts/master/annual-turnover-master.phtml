    <?php endif ?>
    <div class="panel panel-primary">
      <div class="panel panel-heading">
        <h3>Annual Turnover Master List
          <div class="pull-right">
            <a href="/master/add-annual-turnover-master" class="btn btn-success">Add Annual Turnover</a>
          </div></h3>
        </div>
        <div class="panel panel-body">
          <div class="table-responsive" id="transfer-type-list">
            <table class="display" width="100%" id="annualTurnoverMasterTable">
             <thead>
              <th>#</th>
              <th>Annual Turnover Master Name</th>
              <th>Action</th>
            </thead>
            <tbody>
              <?php if($this->annualTurnoverList){
                $i = 1;
                foreach ($this->annualTurnoverList as $annualTurnover) { ?>
                 <tr>
                  <td><?php echo $i; ?></td>
                  <td><?php echo $annualTurnover['annual_turnover']; ?></td>
                  <td>
                    <a href="/master/edit-annual-turnover-master/annual-turnover-master-id/<?php echo md5($annualTurnover['id']); ?>" title="Edit Annual Turnover"><i class="fa fa-pencil" style="color: #1DAA29;"></i></a>
                    &nbsp;&nbsp;
                    <a href="javascript:void(0)" title="Delete Annual Turnover" onclick="deleteannualTurnoverMaster(<?php echo $annualTurnover['id']; ?>)"><i class="fa fa-trash" style="color: red;"></i></a>
