  </div>
  <script>
    $(document).ready(function() {
      $("#annualTurnoverMasterTable").DataTable();
    });

    function deleteannualTurnoverMaster(id) {
      swal({
        title : "Are you sure?",
        text  : "Do you want to delete selected annual turnover master?",
        icon  : "warning",
        buttons : [true, "Yes, Delete"],
        dangerMode : true
      }).then(function (isConfirm) {
        if (!isConfirm) return;
        $.ajax({
          url: "/master/delete-annual-turnover-master/id/"+id,
          context: document.body,
          success: function (data) {
            console.log(data);
            var data = JSON.parse(data);
            if (data.flag) {
              swal({
                title: "Deleted", 
                text: data.message, 
                icon: "success"
              }).then(function() {
                window.location.href="/master/annual-turnover-master";
              });
            } else {
              swal({
                title: "Failed !", 
                text: data.message, 
                icon: "error"
              });
            } 
          }
        });
      });
    }
  </script>

