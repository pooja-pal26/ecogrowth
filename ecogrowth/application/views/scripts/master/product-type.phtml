  </div>

  <script type="text/javascript">
    $(document).ready(function() {
      $("#productTypeListTable").DataTable();
    });
    function deleteProductType(id, name) {
      swal({
        title: "Are you sure?",
        text: " Do You want to delete selected product type?",
        icon: "warning",
        buttons : [true, "Yes, Delete"],
        dangerMode : true
      }).then(function (isConfirm) {
        if (!isConfirm) return;
        $.ajax({
          url: "/master/delete-product-type/id/"+id,
          success: function (data) {
            var data = JSON.parse(data);
            if (data.flag) {
              swal({
                title : "Deleted",
                text : data.message,
                icon : "success"
              }).then(function(){
                location.reload("/master/product-type");
              });
            } else {
              swal({
                title : "Failed !",
                text : data.message,
                icon : "error"
              });
            }
          }
        });
      });
    }
  </script>
