          </div>
        <?php } ?>
      <?php endforeach ?>
    <?php endif ?>
    <div class="panel panel-primary">
      <div class="panel panel-heading">
        <h3>Product Type List
          <div class="pull-right">
            <a href="/master/add-product-type" class="btn btn-success">Add Product Type</a>
          </div></h3>
        </div>
        <div class="panel panel-body">
          <div class="table-responsive" id="transfer-type-list">
            <table class="display" width="100%" id="productTypeListTable">
             <thead>
              <th >#</th>
              <th>Product Type</th>
              <th>Action</th>
            </thead>
            <tbody>
              <?php if($this->productlist){
                $i = 1;
                foreach ($this->productlist as $products) { ?>
                 <tr>
                  <td><?php echo $i; ?></td>
                  <td><?php echo $products['product_type_name']; ?></td>
                  <td>
                    <a href="/master/edit-product-type/product-type-id/<?php echo md5($products['id']);?>" class="todoedit" title="Edit Product Type"><span class="fa fa-pencil" style="color: #1DAA29;"></span></a>
                    &nbsp;&nbsp;
                    <a href="javascript:void(0)" class="tododelete redcolor" onclick="deleteProductType('<?php echo $products['id'];?>','<?php echo $products['product_type_name'];?>')" title="Delete Product Type"><span class="fa fa-trash" style="color: red;"></span></a>
