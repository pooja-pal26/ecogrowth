                  <td><?php echo $productBrands['brand_name']; ?></td>
                  <td>
                    <a href="/master/edit-product-brand/product-brand-id/<?php echo md5($productBrands['id']);?>" class="todoedit" title="Edit Product Brand Name"><span class="fa fa-pencil" style="color: #1DAA29;"></span></a>
                    &nbsp;&nbsp;
                    <a href="javascript:void(0)" class="tododelete redcolor" onclick="deleteProductBrand('<?php echo $productBrands['id'];?>','<?php echo $productBrands['brand_name']; ?>')" title="Delete Product Brand Name"><span class="fa fa-trash" style="color: red;"></span></a>
