  <script type="text/javascript">
    $(document).ready(function() {
      $("#productBrandListTable").DataTable();
    });
    function deleteProductBrand(id, name) {
      swal({
        title : "Are you sure?",
        text  : "Do you want to delete "+name+" from product brand?",
        icon  : "warning",
        buttons : [true, "Yes, Delete"],
        dangerMode : true
      }).then(function(isConfirm){
        if (!isConfirm) {
          return false;
        } else {
          $.ajax({
            url: '/master/delete-product-brand/id/'+id+'/name/'+name,
            type: 'GET',
            success:function(data){
              var data = JSON.parse(data);
              if (data.flag) {
                swal({
                  title : "Deleted",
                  text  : data.message,
                  icon  : "success",
                }).then(function(){
                  location.reload("/master/product-brand-list");
                });
              } else {
                swal({
                  title : "Failed !",
                  text  : data.message,
                  icon  : "error"
                });           
              }
            }
          });

        }
      });
    }
  </script>

