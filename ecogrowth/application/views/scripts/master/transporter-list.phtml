  </div>
</div>
<!-- Add Transporter Modal : END -->
<script>
  $(document).ready(function() {
    $("#transporterListTable").DataTable();
    $("#saveTransporter").click(function(event) {
      event.preventDefault();
      var transporter_name = $("#transporter_name").val();
      var contact_number = $("#contact_number").val();
      var gst_number = $("#gst_number").val();
      if (transporter_name == "") {
        swal({
          title : "Transporter Name Missing!",
          text  : "Please enter transporter name.",
          icon  : "error"
        }).then(function(){
          $("#transporter_name").focus();
        });
        return false;
      } else if (contact_number != "" && (contact_number.length > 10 || contact_number.length < 10)) {
       swal({
        title : "Invalid Contact Number!",
        text  : "Please enter 10 digit valid contact number.",
        icon  : "error"
      }).then(function(){
        $("#contact_number").focus();
      });
      return false;
    } else if (gst_number != "" && (gst_number.length > 15 || gst_number.length < 15)) {
     swal({
      title : "Invalid GST Number!",
      text  : "Please enter 15 digit valid GST number.",
      icon  : "error"
    }).then(function(){
      $("#gst_number").focus();
    });
    return false;
  } else {
    $("#addTransporterModal").modal('toggle');
    $("#loading-bg").show();
    $.ajax({
      url: '/master/add-transporter',
      type: 'POST',
      data: $("#addtranporterForm").serialize(),
      success:function(data){
        $("#loading-bg").hide();
        var data = JSON.parse(data);
        console.log(data);
        if (data.flag) {
          swal({
            title : data.title,
            text  : data.message,
            icon  : "success"
          }).then(function(){
            window.location.reload();
          });
        } else {
          swal({
            title : data.title,
            text  : data.message,
            icon  : "error"
          }).then(function(){
            $("#addTransporterModal").modal('toggle');
          });
          return false;
        }
      }
    });

  }
});
  });

  function deactivateActivateDeleteTransporter(id, type) {
    swal({
      title : "Are you sure?",
      text  : "Do you want to "+type+" clicked transporter?",
      icon  : "warning",
      buttons : [true, "Yes, "+type],
      dangerMode : true
    }).then(function(isConfirm){
      if (!isConfirm) {
        return false;
      } else {
        $("#loading-bg").show();
        $.ajax({
          url  : '/master/activate-deactivate-delete-transporter',
          type : 'POST',
          data : {type:type, transporter_id:id},
          success:function(data){
            var data = JSON.parse(data);
            $("#loading-bg").hide();
            if (data.flag) {
              swal({
                title : data.title,
                text  : data.message,
                icon  : "success",
              }).then(function(){
                location.reload("/master/transporter-list");
              });
            } else {
              swal({
                title : data.title,
                text  : data.message,
                icon  : "error"
              });           
            }
          }
        });
      }
    });
  }
</script>

