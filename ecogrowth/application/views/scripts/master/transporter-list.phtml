              <label for="contact_person">Contact Person</label>
              <input type="text" class="form-control" name="contact_person" id="contact_person" placeholder="Transporter Contact Person" oninput="this.value = this.value.replace(/[^a-z A-Z]/g,'')">
            </div> 
            <div class="form-group col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <label for="contact_number">Contact Number</label>
              <input type="text" class="form-control" name="contact_number" id="contact_number" placeholder="Tansporter Contact Number" oninput="this.value = this.value.replace(/[^0-9]/g,'')">
            </div>
