              <label for="gst_number">GST Number</label>
              <input type="text" class="form-control" name="gst_number" id="gst_number" placeholder="Transporter GST Number">
            </div>

            <div class="form-group col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <button class="btn btn-primary" id="saveTransporter">Submit</button>
            </div>
          </form>
        </div>
