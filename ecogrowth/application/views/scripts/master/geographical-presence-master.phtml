  </div>
  <script>
    $(document).ready(function() {
      $("#GeographicalPresenceMasterTable").DataTable();
    });

    function deleteGeographicalPresenceMaster(id) {
      swal({
        title : "Are you sure?",
        text  : "Do you want to delete selected geographical presence master?",
        icon  : "warning",
        buttons : [true, "Yes, Delete"],
        dangerMode : true
      }).then(function (isConfirm) {
        if (!isConfirm) return;
        $.ajax({
          url: "/master/delete-geographical-presence-master/id/"+id,
          context: document.body,
          success: function (data) {
            console.log(data);
            var data = JSON.parse(data);
            if (data.flag) {
              swal({
                title: "Deleted", 
                text: data.message, 
                icon: "success"
              }).then(function() {
                window.location.href="/master/geographical-presence-master";
              });
            } else {
              swal({
                title: "Failed !", 
                text: data.message, 
                icon: "error"
              });
            } 
          }
        });
      });
    }
  </script>

