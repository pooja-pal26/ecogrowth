    <div class="panel panel-primary">
      <div class="panel panel-heading">
        <h3>Geographical Presence Master List
          <div class="pull-right">
            <a href="/master/add-geographical-presence-master" class="btn btn-success">Add Geographical Presence</a>
          </div></h3>
        </div>
        <div class="panel panel-body">
          <div class="table-responsive" id="transfer-type-list">
            <table class="display" width="100%" id="GeographicalPresenceMasterTable">
             <thead>
              <th>#</th>
              <th>Geographical Presence Master Name</th>
              <th>Action</th>
            </thead>
            <tbody>
              <?php if($this->geographicalPresenceDetails){
                $i = 1;
                foreach ($this->geographicalPresenceDetails as $geographicalPresence) { ?>
                 <tr>
                  <td><?php echo $i; ?></td>
                  <td><?php echo $geographicalPresence['geographical_presence']; ?></td>
                  <td>
                    <a href="/master/edit-geographical-presence-master/geographical-presence-master-id/<?php echo md5($geographicalPresence['id']); ?>" title="Edit Geographical Presence"><i class="fa fa-pencil" style="color: #1DAA29;"></i></a>
                    &nbsp;&nbsp;
                    <a href="javascript:void(0)" title="Delete Geographical Presence" onclick="deleteGeographicalPresenceMaster(<?php echo $geographicalPresence['id']; ?>)"><i class="fa fa-trash" style="color: red;"></i></a>
