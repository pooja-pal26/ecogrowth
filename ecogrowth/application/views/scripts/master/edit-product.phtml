                        <option value="">Select Product Unit</option>
                        <?php foreach ($this->productUnit as $productUnit): ?>
                            <option value="<?php echo $productUnit['unit_name']; ?>"<?php echo $productUnit['unit_name'] == $this->productDetails['unit']?"selected":""; ?>><?php echo $productUnit['unit_name']; ?></option>
