                        <?php foreach ($this->productType as $productType): ?>
                            <option value="<?php echo $productType['id']; ?>"<?php echo $productType['id'] == $this->productDetails['product_type_id']?"selected":""; ?>><?php echo $productType['product_type_name']; ?></option>
                        <?php endforeach ?>
                    </select>    
                </div>
                <div class="form-group col-xs-12 col-sm-12 col-md-6 col-lg-6">
                    <label for="product_name">Product Name <span id="mandatory">*</span></label>
                    <input type="text" class="form-control" name="product_name" id="product_name" placeholder="Enter Product Name" value="<?php echo $this->productDetails['product_name']; ?>">
                </div>
                <div class="form-group col-xs-12 col-sm-12 col-md-3 col-lg-3">
                    <label for="product_unit">Product Unit <span id="mandatory">*</span></label>
