<script>
    $(document).ready(function() {
        $("#product_category").select2();
        $("#product_unit").select2();
    }); 
    function validateInputData() {
        var productType     = $("#product_category").val();
        var productName     = $("#product_name").val();
        var productUnit     = $("#product_unit").val();
        var productPrice    = $("#price").val();
        if (productType == "") {
            swal({
                title : "Product Type Missing !",
                text  : "Please Select Product Type",
                icon  : "error"
            }).then(function() {
                $("#product_category").focus();
            });
            return false;
        } else if (productName == "") {
            swal({
                title : "Product Name Missing !",
                text  : "Please Enter Product Name",
                icon  : "error"
            }).then(function() {
                $("#product_name").focus();
            });
            return false;
        } else if (productUnit == "") {
            swal({
                title : "Product Unit Missing !",
                text  : "Please Select Product Unit",
                icon  : "error"
            }).then(function() {
                $("#product_unit").focus();
            });
            return false;
        } else if (productPrice == "") {
            swal({
                title : "Product Price Missing !",
                text  : "Please Enter Product Price",
                icon  : "error"
            }).then(function() {
                $("#price").focus();
            });
            return false;
        }
    }
</script>