<script type="text/javascript">
  function CallPrint(strid) {
    var prtContent = document.getElementById(strid);
    var WinPrint = window.open('', '', 'left=250px,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
    WinPrint.document.write('<link href="/css/simpletable.css" rel="stylesheet">');
    WinPrint.document.writeln("<style type='text/css'>.prt{color:black !important; } </style>");
    WinPrint.document.writeln("<style type='text/css'>.noprint{display:none !important; } </style>");
    WinPrint.document.write(prtContent.innerHTML);
    WinPrint.document.close();
    setTimeout(function () { WinPrint.print(); }, 500);
    return false
  }
</script> 

