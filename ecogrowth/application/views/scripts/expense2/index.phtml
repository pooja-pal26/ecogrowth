<script type="text/javascript">
 function getPage(page,order,type){
  if(type == undefined){ var type = '';} else { var type = type;}  
  if(order == undefined){ var order = '';} else { var order = order;} 
  var ponumber=$("#ponumber").val(); 
  if(ponumber == undefined){ var ponumber = '';} else { var ponumber = ponumber; } 
  var siteid=$("#siteid").val(); 
  if(siteid == undefined){ var siteid = '';} else { var siteid = siteid; }
  var url   = '/expense/expense-list/page/'+page+'/ponumber/'+ponumber+"/siteid/"+siteid+"/order/"+order+"/type/"+type;
  var id    = 'expense-list';
  $("#"+id).html('<div class="loading">Loading&#8230;</div>');
  $.ajax({
    url: url,
    context: document.body,
    success: function(responseText) {
      $("#"+id).html(responseText);
      $("#"+id).find("script").each(function(i) {
        eval($(this).text());
      });
    }
  });
}   
</script>

<script type="text/javascript">
  function showDetailedExpenseList(po_no,site_id){
    $("#modal-id").modal({ backdrop: 'static', keyboard: false });
    $.ajax({
      type : 'POST',
      url  : '/expense/show-detailed-expense-list',
      data  : {po_no:po_no,site_id:site_id},
      cache : false,
      success : function(responseText){
//alert(responseText);
$('#result-div').html(responseText);
$('#modal-id').modal('show'); 
},
});
  }
</script>

