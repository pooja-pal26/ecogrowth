<script type="text/javascript">

function selectSource(){
var source = $('#expenses_source').val();
if(source==''){ $('#site_expenses').hide(); $('#office_expenses').hide(); }
if(source=='site_expenses'){  $('#site').show(); $('#office').hide();  }
if(source=='office_expenses'){  $('#site').hide(); $('#office').show(); }
}
</script>

<script type="text/javascript">
function validateFile(){
var filename  = $('#attachment').get(0).files[0].name;
var filesize  = $('#attachment').get(0).files[0].size;
var fileext   = $('#attachment').get(0).files[0].name.split('.').pop().toLowerCase(); 
var extArryay = new Array('xls' ,'xlsx' , 'pdf' , 'png' , 'jpeg' , 'jpg');             
var isValidFileExt = $.inArray(fileext, extArryay);  
if (isValidFileExt == -1) {
swal('Invalid File Extension , Upload Only .xls or .xlsx File');
$('#attachment').replaceWith($('#attachment').val('').clone(true));
} else {
if (filesize > 4000000) { 
swal('Invalid File Size , Size Should be below 4Mb');
$('#attachment').replaceWith($('#attachment').val('').clone(true));
 } else { 
//swal('Valid File , You Can Proceed');
 }  
   }
      }  

function validateFile2(){
var filename  = $('#attachment2').get(0).files[0].name;
