    function validateUser(){ 

           var expenses_source = $('#expenses_source').val();
           

           if(expenses_source == 'site_expenses'){

            if(document.getElementById("site_id").value==""){
            swal("Please Select Site ID");
            document.getElementById("site_id").focus();
            return false;
            }

           if(document.getElementById("po_no").value==""){
            swal("Please Select PO No.");
            document.getElementById("po_no").focus();
            return false;
           }

            if(document.getElementById("transfer_for").value==""){
            swal("Please Select Transfer For");
            document.getElementById("transfer_for").focus();
            return false;
            }

            if(document.getElementById("amount").value==""){
            swal("Please Enter Amount");
            document.getElementById("amount").focus();
            return false;
            } 

            if(document.getElementById("transfer_date").value==""){
            swal("Please Select Transfer Date");
            document.getElementById("transfer_date").focus();
            return false;
            } 

            if(document.getElementById("transfered_to").value==""){
            swal("Please Select Transfer To");
            document.getElementById("transfered_to").focus();
            return false;
            }  

           }


           if(expenses_source == 'office_expenses'){

            if(document.getElementById("transfer_for2").value==""){
            swal("Please Select Transfer For");
            document.getElementById("transfer_for2").focus();
            return false;
            }

            if(document.getElementById("amount2").value==""){
            swal("Please Enter Amount");
            document.getElementById("amount2").focus();
            return false;
            } 

            if(document.getElementById("transfer_date2").value==""){
            swal("Please Select Transfer Date");
            document.getElementById("transfer_date2").focus();
            return false;
            } 

            if(document.getElementById("transfered_to2").value==""){
            swal("Please Select Transfer To");
            document.getElementById("transfered_to2").focus();
            return false;
            }  

           }


}
</script>



